# Production template for https://garment-erp.codeplaystudios.com (shared hosting, profile A).
# Copy to <home>/envs/garment-erp.env on the server (chmod 600), OUTSIDE the web root. Never commit real values.
# bootstrap/app.php loads that file automatically. Verify with: php artisan app:security-check
# Full procedure: docs/DEPLOYMENT.md

APP_NAME="Garment ERP"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show (on the server), paste here
APP_DEBUG=false
# Frontend and API share one origin: the static export is at /, Laravel at /api and /sanctum.
APP_URL=https://garment-erp.codeplaystudios.com
FRONTEND_URL=https://garment-erp.codeplaystudios.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# MySQL database created in the hosting panel (cPanel > MySQL Databases); the user needs ALL PRIVILEGES on it.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci   # works on MySQL 8 and MariaDB
DB_SLOW_QUERY_MS=200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null               # host-only cookie: frontend and API are the same origin
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=garment-erp.codeplaystudios.com
CORS_ALLOWED_ORIGINS=https://garment-erp.codeplaystudios.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=garment_erp_
DOCUMENTS_DISK=private
DOCUMENTS_ROOT=                   # absolute path OUTSIDE the web root, e.g. /home/<user>/garment-erp-documents

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_PROXIES=                  # host proxy IPs, only if the host terminates TLS in front of PHP
AUDIT_DB_TRIGGERS=true            # set false only if the host forbids CREATE TRIGGER (docs/DEPLOYMENT.md §4)

# First run only (ProductionBootstrapSeeder). Remove after the first login.
SEED_ORG_NAME=
SEED_ORG_LEGAL_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=              # leave empty: a random password is printed once
