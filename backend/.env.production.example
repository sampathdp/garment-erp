# Production template (shared hosting, profile A). Fill on the server only; never commit real values.
# Verify with: php artisan app:security-check

APP_NAME="Garment ERP"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show, store in the host's env / .env (chmod 600)
APP_DEBUG=false
APP_URL=https://api.example.lk
FRONTEND_URL=https://app.example.lk

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci   # use utf8mb4_0900_ai_ci if the host runs MySQL 8 (not MariaDB)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_DOMAIN=.example.lk
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=app.example.lk
CORS_ALLOWED_ORIGINS=https://app.example.lk

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
DOCUMENTS_DISK=private
DOCUMENTS_ROOT=                   # absolute path OUTSIDE public_html

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

TRUSTED_PROXIES=                  # host proxy IPs, only if the host terminates TLS in front of PHP
AUDIT_DB_TRIGGERS=true            # set false only if the host forbids CREATE TRIGGER
